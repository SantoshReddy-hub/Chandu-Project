# Copy this file to ".env" and change the values before the first run.
# docker compose reads .env automatically; the scanner reads the same variables.

# Password that protects the OWASP ZAP engine's API (any long random string).
ZAP_API_KEY=change-me-to-a-long-random-string

# Secret used to create domain-ownership tokens for Full scans (any long random string).
# Leave empty to have one generated automatically in data/secret.key.
SCANNER_SECRET=
